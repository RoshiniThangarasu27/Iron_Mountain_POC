# --- PostgreSQL ---
POSTGRES_USER=docs
POSTGRES_PASSWORD=docs
POSTGRES_DB=docs

# --- Backend (FastAPI) ---
BACKEND_PORT=8000
MAX_UPLOAD_SIZE_MB=25
MAX_FILES_PER_UPLOAD=50
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# --- Frontend (Next.js) ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
